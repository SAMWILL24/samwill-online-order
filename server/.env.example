PORT=4000
PUBLIC_URL=http://localhost:4000
# Point this at a mounted persistent Volume in production (e.g. Railway) - the
# app's own filesystem gets wiped on every redeploy otherwise, taking the
# database and uploaded menu photos with it. Left unset, defaults to ./data.
DATA_DIR=
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-too
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
ADMIN_EMAIL=admin@samwill.local
ADMIN_PASSWORD=change-me-on-first-login
# CardPointe credentials are per-store, not global - each restaurant enters its
# own Site/Merchant ID/API Username/API Password in Settings > Payments.
