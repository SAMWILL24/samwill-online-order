PORT=4000
PUBLIC_URL=http://localhost:4000
# Point this at a mounted persistent Volume in production (e.g. Railway) - the
# app's own filesystem gets wiped on every redeploy otherwise, taking the
# database and uploaded menu photos with it. Left unset, defaults to ./data.
DATA_DIR=
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-too
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
ADMIN_EMAIL=admin@samwill.local
ADMIN_PASSWORD=change-me-on-first-login
# CardPointe credentials are per-store, not global - each restaurant enters its
# own Site/Merchant ID/API Username/API Password in Settings > Payments.
# Order-confirmation emails (to customers) and new-order alerts (to store
# admins) are sent via Resend's HTTPS API - same provider already used for
# the signage server's device alerts, since Railway blocks outbound SMTP.
RESEND_API_KEY=
EMAIL_FROM=SAMWILL Online <orders@samwillmedia.com>
# Rotating on-volume SQLite snapshots (backups/ under DATA_DIR) - protects
# against a bad migration or accidental data corruption, not against losing
# the Volume itself. Defaults: daily, keep the last 7.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=7
# Optional: also upload each backup to a dedicated, fully private Cloudflare
# R2 bucket for offsite protection. This MUST be a separate bucket from the
# signage server's media bucket, which has a public custom domain - backups
# contain customer PII and password hashes and must never be reachable from
# a public URL. Leave unset to skip offsite upload (local rotation only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
