<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Admin Login - SAMWILL Online Order</title>
  <style>
    body { font-family: system-ui, sans-serif; background: linear-gradient(160deg, #ccfbf1 0%, #f4f7f6 45%); color: #1f2937; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    form { background: #ffffff; padding: 2rem; border-radius: 12px; width: 320px; box-shadow: 0 8px 30px rgba(16,24,40,0.12); }
    h1 { font-size: 1.25rem; margin: 0 0 1.25rem; color: #111827; }
    label { display: block; font-size: 0.85rem; margin-bottom: 0.25rem; color: #6b7280; }
    input { width: 100%; padding: 0.6rem; margin-bottom: 1rem; border-radius: 6px; border: 1px solid #d1d5db; background: #ffffff; color: #1f2937; box-sizing: border-box; }
    button { width: 100%; padding: 0.7rem; border: none; border-radius: 6px; background: #0d9488; color: #fff; font-weight: 600; cursor: pointer; }
    button:hover { background: #0f766e; }
    .error { color: #dc2626; font-size: 0.85rem; margin-bottom: 1rem; }
    .logo-row { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem; }
    .logo-row img { height: 36px; width: auto; }
    .logo-row h1 { font-size: 1.1rem; margin: 0; }
    .forgot-link { display: block; text-align: right; font-size: 0.8rem; margin: -0.5rem 0 1rem; color: #0d9488; text-decoration: none; }
    .forgot-link:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <form method="post" action="<%= `/${store.slug}/admin/login` %>">
    <div class="logo-row">
      <img src="/logo.png" alt="SAMWILL" />
      <h1><%= store.name %> &mdash; Staff Login</h1>
    </div>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required autofocus />
    <label for="password">Password</label>
    <input type="password" id="password" name="password" required />
    <a class="forgot-link" href="<%= `/${store.slug}/admin/forgot-password` %>">Forgot password?</a>
    <button type="submit">Log In</button>
  </form>
</body>
</html>
