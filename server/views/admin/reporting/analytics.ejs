<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Analytics - SAMWILL Kitchen Admin</title>
  <%- include('../_sidebar', { section, page, adminEmail, store }) %>
  <style>
    .bar-chart { display: flex; align-items: flex-end; gap: 4px; height: 180px; margin-top: 1rem; }
    .bar-chart .bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
    .bar-chart .bar { width: 100%; background: #0d9488; border-radius: 3px 3px 0 0; min-height: 2px; }
    .bar-chart .bar-label { font-size: 0.6rem; color: #888; margin-top: 0.3rem; writing-mode: vertical-rl; text-orientation: mixed; max-height: 40px; }
    .top-item-row { display: flex; justify-content: space-between; border-top: 1px solid #2a2a30; padding: 0.6rem 0; }
    .top-item-row:first-child { border-top: none; }
  </style>

  <h1>Reporting</h1>
  <div class="tabs">
    <a href="/<%= store.slug %>/admin/reporting/order-reports" class="<%= page === 'order-reports' ? 'active' : '' %>">Order Reports</a>
    <a href="/<%= store.slug %>/admin/reporting/analytics" class="<%= page === 'analytics' ? 'active' : '' %>">Analytics</a>
  </div>

  <div class="card">
    <h3 style="margin-top:0;">Revenue - last 30 days</h3>
    <div class="bar-chart" id="chart"></div>
  </div>

  <div class="card">
    <h3 style="margin-top:0;">Top selling items</h3>
    <div id="topItems"></div>
  </div>

  <script>
    const STORE_SLUG = '<%= store.slug %>';
    function money(cents) { return '$' + (cents / 100).toFixed(2); }

    async function load() {
      const res = await fetch(`/${STORE_SLUG}/admin/api/reports/analytics`);
      const data = await res.json();

      const maxRevenue = Math.max(1, ...data.revenueByDay.map(d => d.revenueCents));
      document.getElementById('chart').innerHTML = data.revenueByDay.map(d => `
        <div class="bar-col" title="${d.day}: ${money(d.revenueCents)}">
          <div class="bar" style="height:${Math.max(2, (d.revenueCents / maxRevenue) * 160)}px"></div>
          <div class="bar-label">${d.day.slice(5)}</div>
        </div>
      `).join('') || '<p class="muted">No orders in the last 30 days yet.</p>';

      document.getElementById('topItems').innerHTML = data.topItems.map(i => `
        <div class="top-item-row">
          <span>${i.name}</span>
          <span class="muted">${i.totalQuantity} sold &middot; ${money(i.totalRevenueCents)}</span>
        </div>
      `).join('') || '<p class="muted">No sales data yet.</p>';
    }

    load();
  </script>

  <%- include('../_sidebar_close') %>
</body>
</html>
