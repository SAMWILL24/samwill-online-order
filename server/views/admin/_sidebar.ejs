<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body { font-family: system-ui, sans-serif; background: #f4f7f6; color: #1f2937; margin: 0; display: flex; min-height: 100vh; }
  a { color: inherit; }

  .admin-sidebar { width: 240px; flex-shrink: 0; background: #ffffff; border-right: 1px solid #e5e7eb; display: flex; flex-direction: column; }
  .sidebar-brand { display: flex; align-items: center; gap: 0.6rem; padding: 1.1rem 1.2rem; font-weight: 700; color: #0f766e; border-bottom: 1px solid #e5e7eb; background: #f0fdfa; }
  .sidebar-brand img { height: 28px; width: auto; }
  .sidebar-nav { padding: 0.6rem 0; overflow-y: auto; }
  .nav-section { }
  .nav-section-header {
    display: flex; align-items: center; gap: 0.7rem; padding: 0.65rem 1.2rem;
    color: #4b5563; text-decoration: none; font-size: 0.9rem; cursor: pointer; border-left: 3px solid transparent;
  }
  .nav-section-header .icon { width: 18px; height: 18px; flex-shrink: 0; }
  .nav-section-header .chevron { margin-left: auto; font-size: 0.7rem; transition: transform 0.15s; }
  .nav-section.open .chevron { transform: rotate(90deg); }
  .nav-section.active > .nav-section-header { color: #0d9488; border-left-color: #0d9488; background: rgba(13,148,136,0.08); font-weight: 600; }
  .nav-section-header:hover { color: #111827; }
  .nav-subitems { list-style: none; margin: 0; padding: 0; display: none; }
  .nav-section.open .nav-subitems { display: block; }
  .nav-subitems li a {
    display: block; padding: 0.5rem 1.2rem 0.5rem 3rem; font-size: 0.85rem; color: #6b7280; text-decoration: none; border-left: 3px solid transparent;
  }
  .nav-subitems li a:hover { color: #111827; }
  .nav-subitems li a.active { color: #0d9488; border-left-color: #0d9488; background: rgba(13,148,136,0.08); font-weight: 600; }

  .admin-content { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .admin-topbar { display: flex; align-items: center; gap: 1rem; padding: 0.8rem 1.5rem; border-bottom: 1px solid #e5e7eb; background: #ffffff; }
  .admin-topbar .spacer { flex: 1; }
  .admin-topbar .who { color: #6b7280; font-size: 0.8rem; }
  .admin-topbar form { display: inline; }
  .admin-topbar .logout { background: #fff; border: 1px solid #d1d5db; color: #4b5563; border-radius: 6px; padding: 0.35rem 0.75rem; cursor: pointer; font-size: 0.8rem; }
  .admin-topbar .logout:hover { background: #f3f4f6; }
  .admin-main { flex: 1; overflow-y: auto; padding: 1.5rem; }

  .btn { background: #0d9488; border: none; color: #fff; padding: 0.5rem 0.9rem; border-radius: 6px; cursor: pointer; font-size: 0.85rem; text-decoration: none; display: inline-block; }
  .btn:hover { background: #0f766e; }
  .btn.secondary { background: #eef2f1; color: #1f2937; }
  .btn.secondary:hover { background: #e2e8e6; }
  .btn.danger { background: #dc2626; }
  .btn.danger:hover { background: #b91c1c; }
  .card { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 1.25rem; margin-bottom: 1rem; box-shadow: 0 1px 3px rgba(16,24,40,0.05); }
  input, select, textarea { background: #ffffff; border: 1px solid #d1d5db; color: #1f2937; border-radius: 6px; padding: 0.45rem 0.6rem; font-size: 0.85rem; }
  h1 { font-size: 1.4rem; margin: 0 0 1rem; color: #111827; }
  .muted { color: #6b7280; font-size: 0.85rem; }
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
  .stat-card { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 1.1rem; box-shadow: 0 1px 3px rgba(16,24,40,0.05); }
  .stat-card .label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: #6b7280; margin-bottom: 0.4rem; }
  .stat-card .value { font-size: 1.7rem; font-weight: 700; color: #0f766e; }
  .tabs { display: flex; gap: 1.5rem; border-bottom: 1px solid #e5e7eb; margin-bottom: 1.25rem; }
  .tabs a { padding: 0.6rem 0; color: #6b7280; text-decoration: none; font-size: 0.9rem; border-bottom: 2px solid transparent; }
  .tabs a.active { color: #0d9488; border-bottom-color: #0d9488; font-weight: 600; }
  table.admin-table { width: 100%; border-collapse: collapse; }
  table.admin-table th { text-align: left; font-size: 0.75rem; text-transform: uppercase; color: #6b7280; padding: 0.6rem; border-bottom: 1px solid #e5e7eb; }
  table.admin-table td { padding: 0.6rem; border-bottom: 1px solid #f0f0f3; font-size: 0.88rem; }
</style>

<%
  const base = `/${store.slug}/admin`;
  const NAV = [
    { key: 'home', label: 'Home', href: `${base}`, icon: 'home' },
    { key: 'orders', label: 'Orders', href: `${base}/orders`, icon: 'orders' },
    { key: 'menu', label: 'Menu', icon: 'menu', items: [
      { key: 'overview', label: 'Overview', href: `${base}/menu/overview` },
      { key: 'items', label: 'Items', href: `${base}/menu/items` },
      { key: 'categories', label: 'Categories', href: `${base}/menu/categories` },
      { key: 'add-ons', label: 'Add-ons', href: `${base}/menu/add-ons` },
    ]},
    { key: 'marketing', label: 'Marketing', icon: 'marketing', items: [
      { key: 'coupons', label: 'Coupons', href: `${base}/marketing/coupons` },
      { key: 'loyalty', label: 'Loyalty & Rewards', href: `${base}/marketing/loyalty` },
      { key: 'announcements', label: 'Announcements', href: `${base}/marketing/announcements` },
    ]},
    { key: 'reporting', label: 'Reporting', icon: 'reporting', items: [
      { key: 'order-reports', label: 'Order Reports', href: `${base}/reporting/order-reports` },
      { key: 'analytics', label: 'Analytics', href: `${base}/reporting/analytics` },
    ]},
    { key: 'customers', label: 'Customers', href: `${base}/customers`, icon: 'customers' },
    { key: 'staff', label: 'Staff', href: `${base}/staff`, icon: 'staff' },
    { key: 'design', label: 'Design', icon: 'design', items: [
      { key: 'branding', label: 'Branding', href: `${base}/design/branding` },
      { key: 'media-library', label: 'Media Library', href: `${base}/design/media-library` },
    ]},
    { key: 'settings', label: 'Settings', icon: 'settings', items: [
      { key: 'restaurant-profile', label: 'Restaurant Profile', href: `${base}/settings/restaurant-profile` },
      { key: 'business-hours', label: 'Business Hours', href: `${base}/settings/business-hours` },
      { key: 'order-channels', label: 'Order Channels', href: `${base}/settings/order-channels` },
      { key: 'payments', label: 'Payments', href: `${base}/settings/payments` },
    ]},
  ];
  const ICONS = {
    home: '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>',
    orders: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/>',
    menu: '<path d="M6 3v18M6 3c0 3 3 3 3 6s-3 3-3 6M18 3v18"/>',
    marketing: '<path d="M3 11l18-7-7 18-3-8-8-3z"/>',
    reporting: '<path d="M4 20V10M11 20V4M18 20v-7"/>',
    customers: '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3 3-5 6-5s6 2 6 5"/><circle cx="17" cy="9" r="2.5"/><path d="M17 13c2.2 0 4 1.6 4 4"/>',
    staff: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/>',
    design: '<circle cx="12" cy="12" r="9"/><circle cx="9" cy="10" r="1"/><circle cx="12" cy="8" r="1"/><circle cx="15" cy="10" r="1"/><path d="M12 21a2 2 0 0 1-2-2c0-1 1-1 1-2a2 2 0 0 1 2-2h4a4 4 0 0 0 0-8"/>',
    settings: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 0 1-4 0v-.09a1.7 1.7 0 0 0-1-1.55 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.55-1H3a2 2 0 0 1 0-4h.09a1.7 1.7 0 0 0 1.55-1 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34H9a1.7 1.7 0 0 0 1-1.55V3a2 2 0 0 1 4 0v.09a1.7 1.7 0 0 0 1 1.55 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87V9c.26.42.7.7 1.55 1H21a2 2 0 0 1 0 4h-.09a1.7 1.7 0 0 0-1.55 1z"/>',
  };
  function svgIcon(key) {
    return `<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ICONS[key] || ''}</svg>`;
  }
%>

<aside class="admin-sidebar">
  <div class="sidebar-brand"><img src="/logo.png" alt="SAMWILL" /> <%= store.name %></div>
  <nav class="sidebar-nav">
    <% NAV.forEach(function(item) { %>
      <% const isActiveSection = section === item.key; %>
      <% if (item.items) { %>
        <div class="nav-section <%= isActiveSection ? 'active open' : '' %>">
          <div class="nav-section-header" onclick="this.parentElement.classList.toggle('open')">
            <%- svgIcon(item.icon) %>
            <span><%= item.label %></span>
            <span class="chevron">&#9656;</span>
          </div>
          <ul class="nav-subitems">
            <% item.items.forEach(function(sub) { %>
              <li><a href="<%= sub.href %>" class="<%= isActiveSection && page === sub.key ? 'active' : '' %>"><%= sub.label %></a></li>
            <% }); %>
          </ul>
        </div>
      <% } else { %>
        <div class="nav-section <%= isActiveSection ? 'active' : '' %>">
          <a class="nav-section-header" href="<%= item.href %>" style="text-decoration:none;">
            <%- svgIcon(item.icon) %>
            <span><%= item.label %></span>
          </a>
        </div>
      <% } %>
    <% }); %>
  </nav>
</aside>

<div class="admin-content">
  <header class="admin-topbar">
    <a class="btn secondary" href="<%= (process.env.CORS_ORIGIN ? process.env.CORS_ORIGIN.split(',')[0] : 'http://localhost:5173') + '/' + store.slug %>" target="_blank" rel="noopener">View Storefront</a>
    <div class="spacer"></div>
    <span class="who"><%= adminEmail %><% if (typeof isPlatformAdmin !== 'undefined' && isPlatformAdmin) { %> &middot; Platform Admin<% } %></span>
    <form method="post" action="<%= base %>/logout"><button class="logout" type="submit">Log out</button></form>
  </header>
  <main class="admin-main">
