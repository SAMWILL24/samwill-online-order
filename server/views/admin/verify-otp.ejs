<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Verify Code - SAMWILL Online Order</title>
  <style>
    body { font-family: system-ui, sans-serif; background: linear-gradient(160deg, #ccfbf1 0%, #f4f7f6 45%); color: #1f2937; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    form { background: #ffffff; padding: 2rem; border-radius: 12px; width: 320px; box-shadow: 0 8px 30px rgba(16,24,40,0.12); }
    h1 { font-size: 1.25rem; margin: 0 0 0.5rem; color: #111827; }
    p.hint { font-size: 0.85rem; color: #6b7280; margin: 0 0 1.25rem; }
    label { display: block; font-size: 0.85rem; margin-bottom: 0.25rem; color: #6b7280; }
    input { width: 100%; padding: 0.6rem; margin-bottom: 1rem; border-radius: 6px; border: 1px solid #d1d5db; background: #ffffff; color: #1f2937; box-sizing: border-box; font-size: 1.1rem; letter-spacing: 0.2rem; text-align: center; }
    button { width: 100%; padding: 0.7rem; border: none; border-radius: 6px; background: #0d9488; color: #fff; font-weight: 600; cursor: pointer; }
    button:hover { background: #0f766e; }
    .error { color: #dc2626; font-size: 0.85rem; margin-bottom: 1rem; }
    .resend-btn { margin-top: 0.75rem; background: none; color: #0d9488; font-weight: 500; text-decoration: underline; }
    .resend-btn:hover { background: none; color: #0f766e; }
  </style>
</head>
<body>
  <form method="post" action="<%= `/${store.slug}/admin/login/verify` %>">
    <h1><%= store.name %> &mdash; Verify Code</h1>
    <p class="hint">We emailed a 6-digit code to your address. It expires in 10 minutes.</p>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <label for="code">Code</label>
    <input type="text" id="code" name="code" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="one-time-code" required autofocus />
    <button type="submit">Verify</button>
    <button type="submit" class="resend-btn" formaction="<%= `/${store.slug}/admin/login/verify/resend` %>" formnovalidate>Resend code</button>
  </form>
</body>
</html>
