<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Forgot Password - SAMWILL Online Order</title>
  <style>
    body { font-family: system-ui, sans-serif; background: linear-gradient(160deg, #ccfbf1 0%, #f4f7f6 45%); color: #1f2937; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    form, .card { background: #ffffff; padding: 2rem; border-radius: 12px; width: 320px; box-shadow: 0 8px 30px rgba(16,24,40,0.12); }
    h1 { font-size: 1.1rem; margin: 0 0 1.25rem; color: #111827; }
    p.muted { color: #6b7280; font-size: 0.85rem; }
    label { display: block; font-size: 0.85rem; margin-bottom: 0.25rem; color: #6b7280; }
    input { width: 100%; padding: 0.6rem; margin-bottom: 1rem; border-radius: 6px; border: 1px solid #d1d5db; background: #ffffff; color: #1f2937; box-sizing: border-box; }
    button { width: 100%; padding: 0.7rem; border: none; border-radius: 6px; background: #0d9488; color: #fff; font-weight: 600; cursor: pointer; }
    button:hover { background: #0f766e; }
    a.back-link { display: block; text-align: center; margin-top: 1rem; font-size: 0.85rem; color: #0d9488; text-decoration: none; }
    a.back-link:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <% if (sent) { %>
    <div class="card">
      <h1>Check your email</h1>
      <p class="muted">If an account exists for that email, we've sent a link to reset the password. The link expires in 1 hour.</p>
      <a class="back-link" href="<%= `/${store.slug}/admin/login` %>">Back to login</a>
    </div>
  <% } else { %>
    <form method="post" action="<%= `/${store.slug}/admin/forgot-password` %>">
      <h1><%= store.name %> &mdash; Forgot Password</h1>
      <p class="muted">Enter your email and we'll send you a link to reset your password.</p>
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required autofocus />
      <button type="submit">Send Reset Link</button>
      <a class="back-link" href="<%= `/${store.slug}/admin/login` %>">Back to login</a>
    </form>
  <% } %>
</body>
</html>
