<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Media Library - SAMWILL Kitchen Admin</title>
  <%- include('../_sidebar', { section, page, adminEmail }) %>
  <style>
    .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 1rem; }
    .photo-card { background: #17171a; border: 1px solid #2f2f35; border-radius: 8px; overflow: hidden; }
    .photo-card img { width: 100%; height: 100px; object-fit: cover; display: block; }
    .photo-card .meta { padding: 0.5rem; font-size: 0.7rem; color: #999; }
    .photo-card .in-use { color: #2dd4bf; }
    .photo-card .actions { padding: 0 0.5rem 0.5rem; }
  </style>

  <h1>Design</h1>
  <div class="tabs">
    <a href="/admin/design/branding" class="<%= page === 'branding' ? 'active' : '' %>">Branding</a>
    <a href="/admin/design/media-library" class="<%= page === 'media-library' ? 'active' : '' %>">Media Library</a>
  </div>
  <p class="muted">Photos uploaded via Menu &rarr; Items. Delete unused ones to free up space.</p>

  <div class="photo-grid" id="grid"></div>

  <script>
    async function load() {
      const res = await fetch('/admin/api/photos');
      const data = await res.json();
      const grid = document.getElementById('grid');
      grid.innerHTML = data.photos.map(p => `
        <div class="photo-card">
          <img src="${p.url}" alt="" />
          <div class="meta">
            ${(p.sizeBytes / 1024).toFixed(0)} KB<br>
            ${p.inUse ? '<span class="in-use">In use</span>' : 'Unused'}
          </div>
          <div class="actions">
            <button class="btn danger" style="width:100%;font-size:0.75rem;" onclick="remove('${p.filename}')">Delete</button>
          </div>
        </div>
      `).join('') || '<p class="muted">No uploaded photos yet.</p>';
    }

    async function remove(filename) {
      if (!confirm('Delete this photo?')) return;
      await fetch('/admin/api/photos/' + encodeURIComponent(filename), { method: 'DELETE' });
      load();
    }

    load();
  </script>

  <%- include('../_sidebar_close') %>
</body>
</html>
