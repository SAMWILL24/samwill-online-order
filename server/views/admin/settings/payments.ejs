<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Payments - SAMWILL Kitchen Admin</title>
  <%- include('../_sidebar', { section, page, adminEmail }) %>
  <style>
    .status-pill { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.9rem; border-radius: 999px; font-size: 0.9rem; font-weight: 600; }
    .status-pill.ok { background: rgba(43,107,63,0.25); color: #4ade80; }
    .status-pill.missing { background: rgba(122,42,42,0.25); color: #f87171; }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  </style>

  <h1>Settings</h1>
  <div class="tabs">
    <a href="/admin/settings/restaurant-profile" class="<%= page === 'restaurant-profile' ? 'active' : '' %>">Restaurant Profile</a>
    <a href="/admin/settings/business-hours" class="<%= page === 'business-hours' ? 'active' : '' %>">Business Hours</a>
    <a href="/admin/settings/order-channels" class="<%= page === 'order-channels' ? 'active' : '' %>">Order Channels</a>
    <a href="/admin/settings/payments" class="<%= page === 'payments' ? 'active' : '' %>">Payments</a>
  </div>

  <div class="card">
    <h3 style="margin-top:0;">Stripe</h3>
    <div id="status" class="status-pill">Checking&hellip;</div>
    <p class="muted" style="margin-top:0.75rem;">
      Stripe API keys are configured via the server's <code>.env</code> file
      (<code>STRIPE_SECRET_KEY</code>, <code>STRIPE_WEBHOOK_SECRET</code>) rather than through this
      dashboard, so secret keys are never stored in the database or sent to a browser.
    </p>
  </div>

  <script>
    async function load() {
      const res = await fetch('/admin/api/payments-status');
      const data = await res.json();
      const el = document.getElementById('status');
      if (data.stripeConfigured) {
        el.className = 'status-pill ok';
        el.innerHTML = '<span class="dot"></span> Stripe is configured';
      } else {
        el.className = 'status-pill missing';
        el.innerHTML = '<span class="dot"></span> Stripe is not configured - orders will be placed without real payment processing';
      }
    }
    load();
  </script>

  <%- include('../_sidebar_close') %>
</body>
</html>
