<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Coupons - SAMWILL Kitchen Admin</title>
  <%- include('../_sidebar', { section, page, adminEmail }) %>
  <style>
    .promo-card { display: flex; justify-content: space-between; gap: 1rem; }
    .promo-card .badge { display: inline-block; background: #35353c; border-radius: 999px; padding: 0.15rem 0.6rem; font-size: 0.7rem; margin-right: 0.3rem; }
    .promo-card .badge.active { background: #2b6b3f; }
    .promo-card .badge.inactive { background: #6b2b2b; }
    .field-row { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
    .field-row label { display: flex; flex-direction: column; font-size: 0.75rem; color: #999; gap: 0.2rem; }
    .field-row input, .field-row select { min-width: 120px; }
    .toggle-row { display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; }
  </style>

  <h1>Marketing</h1>
  <div class="tabs">
    <a href="/admin/marketing/coupons" class="<%= page === 'coupons' ? 'active' : '' %>">Coupons</a>
    <a href="/admin/marketing/loyalty" class="<%= page === 'loyalty' ? 'active' : '' %>">Loyalty &amp; Rewards</a>
    <a href="/admin/marketing/announcements" class="<%= page === 'announcements' ? 'active' : '' %>">Announcements</a>
  </div>

  <div class="card">
    <h3 style="margin-top:0;">New coupon or deal</h3>
    <form onsubmit="return createPromotion(event)">
      <div class="field-row">
        <label>Title <input name="title" required /></label>
        <label>Promo code (blank = automatic deal) <input name="code" placeholder="e.g. SAVE10" /></label>
      </div>
      <div class="field-row">
        <label>Description <input name="description" style="width:280px;" /></label>
      </div>
      <div class="field-row">
        <label>Discount type
          <select name="discountType">
            <option value="percent">Percent off</option>
            <option value="fixed">Fixed $ off</option>
          </select>
        </label>
        <label>Discount value <input name="discountValue" type="number" step="0.01" required /></label>
        <label>Minimum order ($) <input name="minSubtotal" type="number" step="0.01" value="0" /></label>
      </div>
      <div class="field-row">
        <label>Days of week (0=Sun..6=Sat, comma sep, blank = every day) <input name="daysOfWeek" placeholder="1,2,3,4,5" /></label>
        <label>Start time (happy hour) <input name="startTime" type="time" /></label>
        <label>End time (happy hour) <input name="endTime" type="time" /></label>
      </div>
      <div class="toggle-row">
        <input type="checkbox" name="autoApply" id="autoApply" />
        <label for="autoApply">Auto-apply (banner deal / happy hour, no code needed)</label>
      </div>
      <button class="btn" type="submit" style="margin-top:0.75rem;">Create Coupon</button>
    </form>
  </div>

  <div id="promotions"></div>

  <script>
    async function api(path, opts) {
      const res = await fetch('/admin/api' + path, { headers: { 'Content-Type': 'application/json' }, ...opts });
      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        alert(body.error || 'Request failed');
        throw new Error(body.error || 'Request failed');
      }
      return res.status === 204 ? null : res.json();
    }

    function money(cents) { return '$' + (cents / 100).toFixed(2); }

    async function loadPromotions() {
      const data = await api('/promotions');
      const container = document.getElementById('promotions');
      container.innerHTML = data.promotions.map(p => `
        <div class="card promo-card">
          <div>
            <span class="badge ${p.is_active ? 'active' : 'inactive'}">${p.is_active ? 'Active' : 'Inactive'}</span>
            ${p.code ? `<span class="badge">Code: ${p.code}</span>` : '<span class="badge">Automatic</span>'}
            ${p.days_of_week || p.start_time ? '<span class="badge">Recurring window</span>' : ''}
            <h3 style="margin: 0.4rem 0 0.2rem;">${p.title}</h3>
            <div style="color:#999; font-size:0.85rem;">${p.description || ''}</div>
            <div style="font-size:0.85rem; margin-top:0.4rem;">
              ${p.discount_type === 'percent' ? p.discount_value + '% off' : money(p.discount_value) + ' off'}
              ${p.min_subtotal_cents ? ' &middot; min order ' + money(p.min_subtotal_cents) : ''}
              ${p.days_of_week ? ' &middot; days: ' + p.days_of_week : ''}
              ${p.start_time ? ' &middot; ' + p.start_time + '-' + p.end_time : ''}
            </div>
          </div>
          <div style="text-align:right;">
            <button class="btn secondary" onclick="toggleActive(${p.id}, ${!p.is_active})">${p.is_active ? 'Deactivate' : 'Activate'}</button>
            <button class="btn danger" onclick="deletePromotion(${p.id})">Delete</button>
          </div>
        </div>
      `).join('') || '<p class="muted">No coupons yet.</p>';
    }

    async function createPromotion(e) {
      e.preventDefault();
      const f = e.target;
      const discountValue = parseFloat(f.discountValue.value);
      await api('/promotions', {
        method: 'POST',
        body: JSON.stringify({
          title: f.title.value,
          code: f.code.value || null,
          description: f.description.value || null,
          discountType: f.discountType.value,
          discountValue: f.discountType.value === 'percent' ? Math.round(discountValue) : Math.round(discountValue * 100),
          minSubtotalCents: Math.round((parseFloat(f.minSubtotal.value) || 0) * 100),
          daysOfWeek: f.daysOfWeek.value || null,
          startTime: f.startTime.value || null,
          endTime: f.endTime.value || null,
          autoApply: f.autoApply.checked,
        }),
      });
      f.reset();
      loadPromotions();
      return false;
    }

    async function toggleActive(id, isActive) {
      await api('/promotions/' + id, { method: 'PUT', body: JSON.stringify({ isActive }) });
      loadPromotions();
    }

    async function deletePromotion(id) {
      if (!confirm('Delete this coupon?')) return;
      await api('/promotions/' + id, { method: 'DELETE' });
      loadPromotions();
    }

    loadPromotions();
  </script>

  <%- include('../_sidebar_close') %>
</body>
</html>
