<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Staff Login - SAMWILL Online Order</title>
  <style>
    :root {
      --brand: #1596d1;
      --brand-dark: #0d7bad;
      --brand-soft: #e8f6fc;
      --brand-magenta: #d81b7f;
      --brand-magenta-bg: #fce7f3;
      --brand-yellow: #f2a900;
      --ink: #15161a;
      --muted: #6b7280;
      --border: #e5e7eb;
    }
    * { box-sizing: border-box; }
    body {
      font-family: system-ui, sans-serif;
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      padding: 40px 20px;
      color: var(--ink);
      background:
        radial-gradient(circle at 15% 15%, var(--brand-soft) 0%, transparent 42%),
        radial-gradient(circle at 88% 82%, var(--brand-magenta-bg) 0%, transparent 38%),
        #f8fafb;
    }
    .shell {
      width: min(980px, 100%);
      min-height: 600px;
      display: grid;
      grid-template-columns: 1.15fr auto 0.85fr;
      align-items: stretch;
      background: #fff;
      border-radius: 24px;
      box-shadow: 0 30px 70px -30px rgba(15,39,51,.28), 0 1px 2px rgba(15,39,51,.06);
      overflow: hidden;
    }
    .brand {
      padding: 44px 48px;
      display: grid;
      grid-template-rows: 1fr auto;
      row-gap: 24px;
    }
    .brand-hero { min-height: 0; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
    .brand-hero img { height: 140px; width: auto; display: block; margin: 0 0 14px -6px; }
    .brand-hero h1 { font-size: 28px; margin: 0 0 12px; font-weight: 800; letter-spacing: -0.015em; }
    .brand-hero p { font-size: 15px; line-height: 1.7; color: var(--muted); max-width: 44ch; margin: 0; }
    .contact-list { list-style: none; margin: 0; padding: 22px 0 0; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 12px; }
    .contact-list li { display: flex; align-items: center; gap: 12px; font-size: 13.5px; }
    .contact-list a { color: var(--ink); text-decoration: none; }
    .contact-list a:hover { color: var(--brand-dark); text-decoration: underline; }
    .contact-icon { width: 28px; height: 28px; flex-shrink: 0; border-radius: 8px; background: var(--brand-soft); display: flex; align-items: center; justify-content: center; }
    .contact-icon svg { width: 14px; height: 14px; }
    .divider { width: 1px; background: var(--border); margin: 40px 0; }
    .card { position: relative; background: var(--brand-soft); padding: 52px 44px; display: flex; flex-direction: column; justify-content: center; }
    .card-accent { position: absolute; inset: 0 0 auto 0; height: 5px; background: linear-gradient(90deg, var(--brand), var(--brand-magenta) 55%, var(--brand-yellow)); }
    .card h2 { margin: 0 0 4px; font-size: 20px; font-weight: 800; }
    .card .sub { margin: 0 0 24px; color: var(--muted); font-size: 13.5px; }
    .card label { display: block; font-size: 12px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 6px; }
    .card input { width: 100%; padding: 0.65rem 0.75rem; margin-bottom: 1.1rem; border-radius: 8px; border: 1px solid var(--border); background: #fff; color: var(--ink); font-size: 0.9rem; }
    .card button { width: 100%; margin-top: 4px; padding: 0.75rem; border: none; border-radius: 8px; background: #0d9488; color: #fff; font-weight: 700; cursor: pointer; font-size: 0.95rem; }
    .card button:hover { background: #0f766e; }
    .error { color: #dc2626; font-size: 0.85rem; margin-bottom: 1rem; }
    @media (max-width: 860px) {
      .shell { grid-template-columns: 1fr; }
      .divider { display: none; }
      .brand, .card { padding: 36px 30px; }
      .card-accent { display: none; }
    }
  </style>
</head>
<body>
  <div class="shell">
    <section class="brand">
      <div class="brand-hero">
        <img src="/logo.png" alt="SAMWILL" />
        <h1>Welcome to SAMWILL</h1>
        <p>From precision printing and laser engraving to managing every digital
          screen and online ordering platform across your locations — one company, one platform.</p>
      </div>
      <ul class="contact-list">
        <li>
          <span class="contact-icon" style="color: var(--brand);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.4"/></svg>
          </span>
          <span>413 East State Street, Granby, Massachusetts 01033, United States</span>
        </li>
        <li>
          <span class="contact-icon" style="color: var(--brand-magenta);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.9 3 3.4 3.4 3 4 3h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z"/></svg>
          </span>
          <a href="tel:+14133135794">413-313-5794</a>
        </li>
        <li>
          <span class="contact-icon" style="color: #b6790a;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 6 8.5 7 8.5-7"/></svg>
          </span>
          <a href="mailto:sam@samwill.net">sam@samwill.net</a>
        </li>
        <li>
          <span class="contact-icon" style="color: var(--brand);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 4 5.7 4 9s-1.4 6.4-4 9c-2.6-2.6-4-5.7-4-9s1.4-6.4 4-9Z"/></svg>
          </span>
          <a href="https://samwill.net" target="_blank" rel="noopener noreferrer">samwill.net</a>
        </li>
      </ul>
    </section>

    <div class="divider"></div>

    <form class="card" method="post" action="/admin/login">
      <span class="card-accent"></span>
      <h2>Sign in to your dashboard</h2>
      <p class="sub">SAMWILL Online Ordering</p>
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required autofocus placeholder="admin@samwill.net" />
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required />
      <button type="submit">Log In</button>
      <p style="text-align:center;margin:12px 0 0;font-size:13px;">
        <a href="/admin/forgot-password" style="color:var(--brand-dark);text-decoration:underline;">Forgot password?</a>
      </p>
    </form>
  </div>
</body>
</html>
