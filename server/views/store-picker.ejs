<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Select a Store - SAMWILL Online Order</title>
  <style>
    body { font-family: system-ui, sans-serif; background: linear-gradient(160deg, #ccfbf1 0%, #f4f7f6 45%); color: #1f2937; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    .card { background: #ffffff; padding: 2rem; border-radius: 12px; width: 340px; box-shadow: 0 8px 30px rgba(16,24,40,0.12); }
    .logo-row { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem; }
    .logo-row img { height: 36px; width: auto; }
    .logo-row h1 { font-size: 1.1rem; margin: 0; color: #111827; }
    p.muted { color: #6b7280; font-size: 0.85rem; margin: 0 0 1.25rem; }
    a.store-link { display: block; padding: 0.7rem 0.9rem; margin-bottom: 0.6rem; border-radius: 6px; background: #f4f7f6; color: #1f2937; text-decoration: none; border: 1px solid #e5e7eb; font-weight: 500; }
    a.store-link:hover { background: #0d9488; border-color: #0d9488; color: #fff; }
    .empty { color: #6b7280; font-size: 0.9rem; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo-row">
      <img src="/logo.png" alt="SAMWILL" />
      <h1>SAMWILL Online</h1>
    </div>
    <p class="muted">Select a restaurant to manage.</p>
    <% if (stores.length === 0) { %>
      <p class="empty">No stores yet.</p>
    <% } else { %>
      <% stores.forEach((s) => { %>
        <a class="store-link" href="<%= `/${s.slug}/admin` %>"><%= s.name %></a>
      <% }) %>
    <% } %>
  </div>
</body>
</html>
