<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Staff Login - SAMWILL Online Order</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #1b1b1f; color: #eee; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    .card { background: #26262b; padding: 2rem; border-radius: 12px; width: 340px; box-shadow: 0 4px 24px rgba(0,0,0,0.4); }
    .logo-row { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem; }
    .logo-row img { height: 36px; width: auto; }
    .logo-row h1 { font-size: 1.1rem; margin: 0; }
    p.muted { color: #aaa; font-size: 0.85rem; margin: 0 0 1.25rem; }
    a.store-link { display: block; padding: 0.7rem 0.9rem; margin-bottom: 0.6rem; border-radius: 6px; background: #17171a; color: #fff; text-decoration: none; border: 1px solid #444; }
    a.store-link:hover { background: #0d9488; border-color: #0d9488; }
    .empty { color: #888; font-size: 0.9rem; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo-row">
      <img src="/logo.png" alt="SAMWILL" />
      <h1>SAMWILL Online &mdash; Staff Login</h1>
    </div>
    <p class="muted">Select your restaurant to sign in.</p>
    <% if (stores.length === 0) { %>
      <p class="empty">No stores yet.</p>
    <% } else { %>
      <% stores.forEach((s) => { %>
        <a class="store-link" href="<%= `/${s.slug}/admin/login` %>"><%= s.name %></a>
      <% }) %>
    <% } %>
  </div>
</body>
</html>
